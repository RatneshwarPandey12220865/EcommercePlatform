# Read by `docker compose -f infra/docker/docker-compose.yml up` from the
# repo root. Copy this file to `.env` and fill in real values - `.env` itself
# is gitignored.

# Razorpay test-mode credentials (see services/payment-service/.env.example)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
