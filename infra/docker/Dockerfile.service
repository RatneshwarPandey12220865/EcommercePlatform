# Generic multi-stage Dockerfile for any of the Spring Boot services.
# Build from repo root: docker build -f infra/docker/Dockerfile.service --build-arg SERVICE=auth-service -t auth-service services/auth-service
FROM eclipse-temurin:25-jdk-jammy AS build
WORKDIR /app
COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .
RUN chmod +x mvnw && ./mvnw -q dependency:go-offline
COPY src src
RUN ./mvnw -q package -DskipTests

FROM eclipse-temurin:25-jre-jammy
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
